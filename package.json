{
  "name": "deepseek-pet",
  "version": "1.2.0",
  "description": "一只住在桌面上的 DeepSeek 鲸鱼娘：可拖拽、可聊天、可打包成免安装 exe",
  "main": "main.js",
  "private": true,
  "license": "MIT",
  "author": "DeepSeek Pet Contributors",
  "keywords": [
    "desktop-pet",
    "electron",
    "deepseek",
    "whale",
    "chatbot"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test.js",
    "check": "node scripts/check.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Linyan30/deepseek-pet.git"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
